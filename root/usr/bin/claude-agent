#!/usr/bin/env python3
"""claude-agent: run Claude Code as an unattended agent.

    claude-agent --version
    claude-agent status     what is installed, and whether this is an agent

Exit codes: 0 ok, 1 something status checks is missing, 2 usage error.
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

VERSION = "0.1.0"
MANAGED = Path("/etc/claude-code/managed-settings.d")
LIBEXEC = Path("/usr/libexec/claude-agent")
FRAGMENTS = {
    "10-claude-agent.json": "claude-agent",
    "20-claude-agent-trentina.json": "claude-agent-trentina",
}


def claude_version() -> str | None:
    claude = shutil.which("claude")
    if not claude:
        return None
    result = subprocess.run([claude, "--version"], capture_output=True, text=True, timeout=30, check=False)
    return result.stdout.strip() or None


def row(label: str, value: str) -> None:
    print(f"{label + ':':<23}{value}")


def status() -> int:
    missing = False
    print(f"claude-agent {VERSION}")
    version = claude_version()
    row("claude", version or "not found")
    missing |= version is None
    for name, package in FRAGMENTS.items():
        present = (MANAGED / name).is_file()
        row(package, "installed" if present else "not installed")
        missing |= package == "claude-agent" and not present
    hooks = LIBEXEC / "hooks.py"
    row("hooks", "present" if os.access(hooks, os.X_OK) else "missing")
    missing |= not os.access(hooks, os.X_OK)
    agent = os.environ.get("CLAUDE_AGENT") == "1"
    row("CLAUDE_AGENT", "1 (hooks active)" if agent else "unset (hooks inactive in this shell)")
    return 1 if missing else 0


def main(argv: list[str]) -> int:
    if argv[1:] in (["--version"], ["-V"]):
        print(f"claude-agent {VERSION}")
        return 0
    if argv[1:] == ["status"]:
        return status()
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
